{
  "fmt": {
    "git": "https://github.com/fmtlib/fmt",
    "ref": "10.2.1",
    "cmake_fragment": "add_subdirectory(external/fmt)\ntarget_link_libraries(flux PUBLIC fmt::fmt)\n"
  },
  "nlohmann-json": {
    "git": "https://github.com/nlohmann/json",
    "ref": "v3.11.3",
    "cmake_fragment": "set(JSON_BuildTests OFF CACHE BOOL \"\" FORCE)\nadd_subdirectory(external/nlohmann-json)\ntarget_link_libraries(flux PUBLIC nlohmann_json::nlohmann_json)\n"
  },
  "charts": {
    "git": "https://github.com/IAmTheFool/charts.git",
    "ref": "main",
    "cmake_fragment": "target_include_directories(flux PUBLIC\n    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/external/charts/include>\n)\n"
  }
}